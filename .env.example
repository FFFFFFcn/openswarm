# Local-only first release. Do not commit real credentials.
OPENSWARM_APP_HOST=127.0.0.1
OPENSWARM_APP_PORT=8000
OPENSWARM_DATABASE_PATH=.data/operations.db
OPENSWARM_WORKSPACE_DIR=.data/workspaces
OPENSWARM_REPORTS_DIR=.data/reports

# 数据接口密钥，推荐在应用管理后台配置，保存后立即生效。
REDFOX_API_KEY=
# 数据接口请求超时（秒）。
OPENSWARM_REDFOX_TIMEOUT_SECONDS=30

# embedded: fakeredis, single process, development only
# external: a real Redis service for durable sessions and teams
OPENSWARM_REDIS_MODE=embedded
OPENSWARM_REDIS_HOST=127.0.0.1
OPENSWARM_REDIS_PORT=6379
OPENSWARM_REDIS_DB=0
OPENSWARM_REDIS_USERNAME=
OPENSWARM_REDIS_PASSWORD=
OPENSWARM_REDIS_SSL=false

OPENSWARM_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
OPENSWARM_ALLOWED_HOSTS=127.0.0.1,localhost
OPENSWARM_LOG_LEVEL=INFO
